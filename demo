(function () {

  // ---- Inject CSS ----
  var style = document.createElement("style");
  style.textContent = `
    .zp-tabs-wrapper {
      font-family: inherit;
      width: 100%;
    }
    .zp-tabs-nav {
      display: flex;
      border-bottom: 2px solid #e5e7eb;
      gap: 0;
      overflow-x: auto;
    }
    .zp-tab-btn {
      padding: 12px 20px;
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      white-space: nowrap;
      transition: color 0.2s, border-color 0.2s;
    }
    .zp-tab-btn:hover {
      color: #333;
    }
    .zp-tab-btn.active {
      color: #111;
      border-bottom: 3px solid #111;
    }
    .zp-tab-panel {
      display: none;
      padding: 20px 4px;
      font-size: 14px;
      color: #555;
      animation: zpTabFade 0.2s ease;
    }
    .zp-tab-panel.active {
      display: block;
    }
    @keyframes zpTabFade {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  `;
  document.head.appendChild(style);

  function init() {
    var reviewsContainer = document.getElementById("zpcomment-list-container");
    var ratingsSection   = document.querySelector(".theme-custom-ratings-section");

    if (!reviewsContainer && !ratingsSection) return;

    var insertTarget = reviewsContainer || ratingsSection;
    var parent = insertTarget.parentNode;

    // Hide loose text nodes
    parent.childNodes.forEach(function (node) {
      if (node.nodeType === 3 && node.textContent.trim().length > 0) {
        node.textContent = "";
      }
    });

    var wrapper = document.createElement("div");
    wrapper.className = "zp-tabs-wrapper";

    var nav = document.createElement("div");
    nav.className = "zp-tabs-nav";

    var panels = [];
    var tabs = [];

    function addTab(label, sourceEl) {
      // Tab button
      var btn = document.createElement("button");
      btn.className = "zp-tab-btn";
      btn.textContent = label;
      nav.appendChild(btn);
      tabs.push(btn);

      // Panel
      var panel = document.createElement("div");
      panel.className = "zp-tab-panel";
      var clone = sourceEl.cloneNode(true);
      var h4 = clone.querySelector("h4");
      if (h4) h4.style.display = "none";
      panel.appendChild(clone);
      panels.push(panel);

      btn.addEventListener("click", function () {
        tabs.forEach(function (t) { t.classList.remove("active"); });
        panels.forEach(function (p) { p.classList.remove("active"); });
        btn.classList.add("active");
        panel.classList.add("active");
      });

      sourceEl.style.display = "none";
    }

    if (reviewsContainer) addTab("Reviews", reviewsContainer);
    if (ratingsSection)   addTab("Ratings", ratingsSection);

    // Activate first tab by default
    if (tabs.length > 0) {
      tabs[0].classList.add("active");
      panels[0].classList.add("active");
    }

    wrapper.appendChild(nav);
    panels.forEach(function (p) { wrapper.appendChild(p); });

    parent.insertBefore(wrapper, insertTarget);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

})();
